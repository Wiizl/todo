<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:TodoLists.Converters"
             x:Class="TodoLists.App">
    <Application.Resources>
        <!-- Theme colors (PageBg, CardBg, TextMain, TextMuted, Primary, Danger, DangerBg, Surface2, Backdrop)
             are assigned in App.xaml.cs so they follow light/dark mode. -->

        <conv:NameConverter x:Key="NameConv" />

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6C5CE7" Offset="0.0" />
            <GradientStop Color="#A06CF7" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="29" />
            <Setter Property="HeightRequest" Value="58" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#6C5CE7" Opacity="0.35" Radius="18" Offset="0,8" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface2}" />
            <Setter Property="TextColor" Value="{DynamicResource TextMain}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HeightRequest" Value="52" />
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource DangerBg}" />
            <Setter Property="TextColor" Value="{DynamicResource Danger}" />
            <Setter Property="Text" Value="✕" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
            <Setter Property="TextColor" Value="{DynamicResource TextMain}" />
            <Setter Property="Text" Value="←" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
