<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoLists.BeerEditPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">
    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="4,14,0,6" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,20" RowSpacing="10">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,16,0,10">
            <Button Style="{StaticResource BackButton}" Clicked="OnBack" />
            <Label x:Name="HeaderLabel" Grid.Column="1" FontSize="26" FontAttributes="Bold"
                   VerticalOptions="Center" TextColor="{DynamicResource TextMain}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="2,0,2,24">
                <Label Text="Title" Style="{StaticResource FieldLabel}" />
                <Border x:Name="TitleBorder" BackgroundColor="{DynamicResource Surface2}" StrokeThickness="2"
                        Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="16,0">
                    <Entry x:Name="TitleEntry" Keyboard="Text" Placeholder="Beer name" MaxLength="80" HeightRequest="52"
                           FontSize="16" BackgroundColor="Transparent"
                           TextColor="{DynamicResource TextMain}" PlaceholderColor="{DynamicResource TextMuted}"
                           Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                </Border>

                <Label Text="Comment" Style="{StaticResource FieldLabel}" />
                <Border x:Name="CommentBorder" BackgroundColor="{DynamicResource Surface2}" StrokeThickness="2"
                        Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="16,6">
                    <Editor x:Name="CommentEditor" Keyboard="Text" Placeholder="Tasting notes…" MaxLength="1000"
                            AutoSize="TextChanges" MinimumHeightRequest="110" FontSize="16"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource TextMain}" PlaceholderColor="{DynamicResource TextMuted}"
                            Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Māris’ rating" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="MarisBorder" BackgroundColor="{DynamicResource Surface2}" StrokeThickness="2"
                                Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="16,0">
                            <Entry x:Name="MarisEntry" Placeholder="0 – 10" Keyboard="Numeric" MaxLength="5"
                                   HeightRequest="52" FontSize="16" BackgroundColor="Transparent"
                                   TextColor="{DynamicResource TextMain}" PlaceholderColor="{DynamicResource TextMuted}"
                                   Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Inese’s rating" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="IneseBorder" BackgroundColor="{DynamicResource Surface2}" StrokeThickness="2"
                                Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="16,0">
                            <Entry x:Name="IneseEntry" Placeholder="0 – 10" Keyboard="Numeric" MaxLength="5"
                                   HeightRequest="52" FontSize="16" BackgroundColor="Transparent"
                                   TextColor="{DynamicResource TextMain}" PlaceholderColor="{DynamicResource TextMuted}"
                                   Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Label x:Name="ErrorLabel" IsVisible="False" FontSize="13" Margin="4,12,0,0"
                       TextColor="{DynamicResource Danger}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="Save" Style="{StaticResource PrimaryButton}" Clicked="OnSave" />
    </Grid>
</ContentPage>
