<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoLists.Controls.TimeOverlay"
             IsVisible="False">
    <Grid x:Name="Backdrop" BackgroundColor="{DynamicResource Backdrop}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped" />
        </Grid.GestureRecognizers>

        <Border x:Name="Card" VerticalOptions="Center" Margin="28,0" Padding="20,24,20,18"
                BackgroundColor="{DynamicResource CardBg}" StrokeThickness="0"
                StrokeShape="RoundRectangle 30" Opacity="0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="30" Offset="0,12" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCardTapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="12">
                <Label Text="Select time" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextMuted}" />
                <Label x:Name="ValueLabel" FontSize="44" FontAttributes="Bold" HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource TextMain}" />

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <ScrollView x:Name="HourScroll" HeightRequest="220" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="HourHost" Spacing="4" />
                    </ScrollView>
                    <Label Grid.Column="1" Text=":" FontSize="28" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{DynamicResource TextMuted}" />
                    <ScrollView x:Name="MinuteScroll" Grid.Column="2" HeightRequest="220" VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="MinuteHost" Spacing="4" />
                    </ScrollView>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancel" />
                    <Button Text="OK" Grid.Column="1" TextColor="White" FontSize="15" FontAttributes="Bold"
                            CornerRadius="18" HeightRequest="52" Background="{StaticResource PrimaryGradient}"
                            Clicked="OnOk" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
