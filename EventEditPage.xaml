<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:TodoLists.Controls"
             x:Class="TodoLists.EventEditPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">
    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="4,14,0,6" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,20" RowSpacing="10">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped" />
            </Grid.GestureRecognizers>

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,16,0,10">
                <Button Style="{StaticResource BackButton}" Clicked="OnBack" />
                <Label x:Name="HeaderLabel" Grid.Column="1" FontSize="26" FontAttributes="Bold"
                       VerticalOptions="Center" TextColor="{DynamicResource TextMain}" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="2,0,2,24">
                    <Label Text="Title" Style="{StaticResource FieldLabel}" />
                    <Border x:Name="TitleBorder" BackgroundColor="{DynamicResource Surface2}" StrokeThickness="2"
                            Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="16,0">
                        <Entry x:Name="TitleEntry" Keyboard="Text" Placeholder="Event name" MaxLength="80"
                               HeightRequest="52" FontSize="16" BackgroundColor="Transparent"
                               TextColor="{DynamicResource TextMain}" PlaceholderColor="{DynamicResource TextMuted}"
                               Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Date" Style="{StaticResource FieldLabel}" />
                            <Border BackgroundColor="{DynamicResource Surface2}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16" Padding="16,0" HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDateTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="DateLabel" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextMain}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Time" Style="{StaticResource FieldLabel}" />
                            <Border BackgroundColor="{DynamicResource Surface2}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16" Padding="16,0" HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTimeTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="TimeLabel" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextMain}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Place" Style="{StaticResource FieldLabel}" />
                    <Border x:Name="PlaceBorder" BackgroundColor="{DynamicResource Surface2}" StrokeThickness="2"
                            Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="16,0">
                        <Entry x:Name="PlaceEntry" Keyboard="Text" Placeholder="Where?" MaxLength="120"
                               HeightRequest="52" FontSize="16" BackgroundColor="Transparent"
                               TextColor="{DynamicResource TextMain}" PlaceholderColor="{DynamicResource TextMuted}"
                               Focused="OnFieldFocused" Unfocused="OnFieldUnfocused" />
                    </Border>

                    <Label x:Name="ErrorLabel" IsVisible="False" FontSize="13" Margin="4,12,0,0"
                           TextColor="{DynamicResource Danger}" />
                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="2" Text="Save" Style="{StaticResource PrimaryButton}" Clicked="OnSave" />
        </Grid>

        <c:CalendarOverlay x:Name="Calendar" />
        <c:TimeOverlay x:Name="Clock" />
    </Grid>
</ContentPage>
