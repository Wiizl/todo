<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:TodoLists.Controls"
             x:Class="TodoLists.KaraokePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBg}">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,20" RowSpacing="10">
            <VerticalStackLayout Grid.Row="0" Spacing="2" Margin="4,20,0,10">
                <Label Text="Karaoke" FontSize="36" FontAttributes="Bold" TextColor="{DynamicResource TextMain}" />
                <Label x:Name="SubtitleLabel" FontSize="15" TextColor="{DynamicResource TextMuted}" />
            </VerticalStackLayout>

            <CollectionView x:Name="List" Grid.Row="1" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Label Text="🎤" FontSize="56" HorizontalOptions="Center" />
                        <Label Text="Nothing here yet" FontSize="20" FontAttributes="Bold"
                               HorizontalOptions="Center" TextColor="{DynamicResource TextMain}" />
                        <Label Text="Tap “Add new” to create an entry."
                               HorizontalTextAlignment="Center" TextColor="{DynamicResource TextMuted}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0" BackgroundColor="{DynamicResource CardBg}"
                                StrokeShape="RoundRectangle 18" Margin="2,2,2,6" Padding="8,8,12,8">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.07" Radius="12" Offset="0,3" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <CheckBox IsChecked="{Binding Done}" Color="{DynamicResource Primary}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Text}" FontSize="16" VerticalOptions="Center"
                                       TextColor="{DynamicResource TextMain}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Done}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Button Grid.Column="2" Style="{StaticResource DeleteButton}" Clicked="OnDelete" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2" Text="＋  Add new" Style="{StaticResource PrimaryButton}" Clicked="OnAdd" />
        </Grid>

        <c:DialogOverlay x:Name="Dialog" />
    </Grid>
</ContentPage>
